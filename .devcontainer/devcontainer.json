{
  "name": "Many Houses",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/terraform:1": { "version": "1.10.5" }
  },
  "containerEnv": { "TZ": "America/Sao_Paulo" },
  "postCreateCommand": "python dev.py setup --with-deps",
  "forwardPorts": [8765],
  "portsAttributes": { "8765": { "label": "Minhas Casas (local, sem login)", "onAutoForward": "notify" } },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "hashicorp.terraform", "editorconfig.editorconfig"]
    }
  }
}
